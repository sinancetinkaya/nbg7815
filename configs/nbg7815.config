#
# Target platform
#
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_zyxel_nbg7815=y

#
# Compile all kernel modules
#
# CONFIG_ALL_KMODS=y

#
# NSS Offloading
#
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_MESH_SUPPORT=y
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_DEFAULT_kmod-qca-nss-dp=y
CONFIG_DEFAULT_kmod-qca-nss-drv=y
CONFIG_DEFAULT_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_DEFAULT_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_sqm-scripts-nss=y
# sqm-scripts-nss depends on kmod-tls
CONFIG_PACKAGE_kmod-tls=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-nss-ifb=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-eogremgr=m
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=m
CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y
CONFIG_PACKAGE_kmod-qca-nss-drv-match=m
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=m
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tun6rd=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vxlanmgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-wifi-meshmgr=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_libnl-nss=y

#
# Compiler Optimization
#
CONFIG_BUILD_PATENTED=y
# Use ccache to speed up subsequent builds
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_EXPERIMENTAL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"
CONFIG_USE_GC_SECTIONS=y

#
# Kernel Config
#
CONFIG_COLLECT_KERNEL_DEBUG=y
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_DYNAMIC_DEBUG=y
CONFIG_KERNEL_ARM_PMU=y
CONFIG_KERNEL_ARM_PMUV3=y
CONFIG_KERNEL_PREEMPT_NONE=y
CONFIG_KERNEL_PREEMPT_NONE_BUILD=y
CONFIG_KERNEL_PAGE_POOL=y

#
# Reduce kernel module size
# Disable unnecessary debugging for Wi-Fi driver.
#
CONFIG_ATH11K_DEBUGFS_HTT_STATS=n
CONFIG_ATH11K_DEBUGFS_STA=n
# Disables thermal throttling support for ath11k.
#CONFIG_ATH11K_THERMAL=n

#
# Package manager for OpenWRT
#
CONFIG_USE_APK=y
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_luci-app-package-manager=y

#
# SSL Configuration
#
#CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_LUA_ECO_OPENSSL=y
#CONFIG_LUA_ECO_MBEDTLS=y
# Optimize OpenSSL for speed over size
CONFIG_OPENSSL_OPTIMIZE_SPEED=y

#
# Wireless Configuration
#
#CONFIG_PACKAGE_wpad-mesh-mbedtls=y
CONFIG_PACKAGE_wpad-mesh-openssl=y
#CONFIG_PACKAGE_wpad-basic-openssl=y

#
# Library Optimization
#
# Optimize common libraries (zlib, zstd) for speed, improving performance on compression tasks.
CONFIG_ZLIB_OPTIMIZE_SPEED=y
CONFIG_ZSTD_OPTIMIZE_O3=y

#
# Feeds Configuration
#
# Prevent package manager from adding custom feeds as repositories in final image.
# They don't exist upstream and will cause errors when trying to update
CONFIG_FEED_nss_packages=n
CONFIG_FEED_sqm_scripts_nss=n
CONFIG_FEED_qosmio=n

#
# Replace dnsmasq with dnsmasq-full for nftset support
#
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_DEFAULT_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_DEFAULT_dnsmasq=n
CONFIG_DEFAULT_odhcpd-ipv6only=n

#
# LUCI
#
#CONFIG_PACKAGE_luci=y
#CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-ksmbd=y

#
# USB Storage Support
#
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

#
# File Systems
#
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-xfs=y

#
# For XFS reflink(snapshot) support
#
CONFIG_PACKAGE_coreutils-cp=y
CONFIG_PACKAGE_chattr=y
CONFIG_PACKAGE_lsattr=y

#
# NBG7815
#
CONFIG_PACKAGE_nbg7815_ble_init=y
CONFIG_PACKAGE_nbg7815_led_config=y
CONFIG_PACKAGE_luci-app-thermals=y

#
# Tools
#
CONFIG_PACKAGE_curl=y
CONFIG_LIBCURL_OPENSSL=y
#CONFIG_LIBCURL_MBEDTLS=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_pigz=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_zram-swap=y
#CONFIG_PACKAGE_syslog-ng=y

#
# lm-sensors isn't needed for IPQ807x devices.
#
CONFIG_HTOP_LMSENSORS=n

## Crash forensics: persist the kernel console and panic traces across
## reboots in the board's ramoops region; the image archives them to
## /root/pstore on the next boot.
CONFIG_PACKAGE_kmod-ramoops=y

## for mesh debugging
CONFIG_MAC80211_MESSAGE_TRACING=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_ATH11K_DEBUGFS=y
CONFIG_ATH11K_TRACING=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_iw=n
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_ethtool=n
CONFIG_PACKAGE_iputils-arping=y
CONFIG_PACKAGE_ncat=y
CONFIG_PACKAGE_bridge-utils=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_conntrack-tools=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_trace-cmd=y
